# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interview_dev  # pragma: allowlist secret
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=interview_dev

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── EPAM Dial API (OpenAI-compatible) ─────────────────────────────────────────
DIAL_API_KEY=your-epam-dial-api-key
DIAL_API_BASE_URL=https://ai-proxy.lab.epam.com/openai/v1
DIAL_API_VERSION=2024-02-01
PRIMARY_MODEL=gpt-4.1-mini-2025-04-14
EVAL_MODEL=gpt-4o

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
ENABLE_DEV_AI_FALLBACK=false
MAX_UPLOAD_SIZE_BYTES=5242880

# ── Frontend (public vars — safe to expose) ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
